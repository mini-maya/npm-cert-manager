# --- NPM connection ---
NPM_URL=http://nginx-proxy-manager:81/api

# Service account used ONLY by the background scheduler (no interactive user
# is logged in during a scheduled run). Interactive Web UI logins use the
# credentials entered by the user in the browser instead - see README.
NPM_SERVICE_IDENTITY=cert-manager-service@example.com
NPM_SERVICE_SECRET_FILE=/app/secrets/npm_service_password.txt

# --- Renewal behaviour ---
RENEW_BEFORE_DAYS=30
CHECK_INTERVAL_SECONDS=21600
KEY_SIZE=2048
KEY_TYPE=rsa

# --- CA ---
CA_KEY_PATH=/app/secrets/ca.key
CA_CERT_PATH=/app/secrets/ca.crt

# --- Storage (no DBMS - plain JSON files) ---
DATA_DIR=/app/data

# --- Web ---
SESSION_SECRET=change-me-to-a-long-random-value
SESSION_COOKIE_NAME=cert_manager_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=86400
